{
  "name": "redactotron",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:api": ".venv/bin/python -m flask --app api.redact:app run --port 5328",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:pii": "node --experimental-strip-types --test tests/pii-recognizers.test.mts",
    "test:engine": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tesseract.js": "^7.0.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
